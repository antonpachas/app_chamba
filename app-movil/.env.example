# ─── Busca PE — Configuración de entorno ───────────────────────────────────────
#
# Este archivo es una plantilla. NO contiene valores reales.
# Para cambiar la URL de la API, pásala como dart-define al compilar.
#
# ─── DESARROLLO LOCAL ──────────────────────────────────────────────────────────
#
#   Emulador Android (apunta al localhost de tu máquina):
#     flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000/api/v1
#
#   Dispositivo físico (reemplaza con la IP de tu PC en la red local):
#     flutter run --dart-define=API_BASE_URL=http://192.168.1.X:8000/api/v1
#
#   Simulador iOS:
#     flutter run --dart-define=API_BASE_URL=http://localhost:8000/api/v1
#
# ─── PRODUCCIÓN ────────────────────────────────────────────────────────────────
#
#   La URL de producción ya está configurada como valor por defecto en:
#   lib/core/config/app_env.dart
#
#   URL actual de producción:
API_BASE_URL=https://jaapsystem.com/v1/chamba/api/v1
#
#   Al hacer el build de producción simplemente corre:
#     flutter build apk
#   (usará el defaultValue de app_env.dart automáticamente)
#
#   Para forzar una URL diferente en el build:
#     flutter build apk --dart-define=API_BASE_URL=https://tudominio.com/api/v1
#
# ─── VS CODE ───────────────────────────────────────────────────────────────────
#
#   Agrega esto en .vscode/launch.json para no tener que escribirlo cada vez:
#
#   {
#     "version": "0.2.0",
#     "configurations": [
#       {
#         "name": "BuscaPE (dev)",
#         "request": "launch",
#         "type": "dart",
#         "args": ["--dart-define=API_BASE_URL=http://10.0.2.2:8000/api/v1"]
#       },
#       {
#         "name": "BuscaPE (prod)",
#         "request": "launch",
#         "type": "dart"
#       }
#     ]
#   }
