<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes

    <IfModule mod_dir.c>
        DirectorySlash Off
    </IfModule>

    RewriteEngine On
    RewriteBase /v1/chamba/

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 1) Si la URL ya viene dentro de public/, no reescribir.
    RewriteRule ^public/ - [L]

    # 2) Si existe el archivo físico en public/, servirlo (assets, scripts, etc.).
    RewriteCond %{DOCUMENT_ROOT}/v1/chamba/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]

    # 3) /app/ con trailing slash → quitar la barra (301 externo).
    RewriteRule ^app/$ /v1/chamba/app [L,R=301]

    # 4) Cualquier otra cosa → front controller.
    #    El propio public/index.php pela el prefijo /v1/chamba del REQUEST_URI
    #    para que Laravel resuelva las rutas correctamente.
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>

DirectoryIndex public/index.php

# Bloquea archivos sensibles si quedaran en raíz.
<FilesMatch "^(\.env|\.env\..+|composer\.json|composer\.lock|artisan|deploy\.sh|DEPLOY\.md|package\.json|package-lock\.json|vite\.config\.js|phpunit\.xml)$">
    Require all denied
</FilesMatch>

# Bloquea acceso directo a carpetas privadas (sin chocar con /app, ruta del SPA,
# que ya está manejada por el RewriteRule de arriba).
RedirectMatch 403 ^/v1/chamba/(bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$)
