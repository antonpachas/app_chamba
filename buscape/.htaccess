<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes

    <IfModule mod_dir.c>
        DirectorySlash Off
    </IfModule>

    RewriteEngine On
    RewriteBase /

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 1) Si la URL ya viene dentro de public/, no reescribir.
    RewriteRule ^public/ - [L]

    # 2) Si existe el archivo físico en public/, servirlo (assets, scripts, etc.).
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]

    # 3) Cualquier otra cosa → front controller.
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>

DirectoryIndex public/index.php

# Bloquea archivos sensibles si quedaran en raíz.
<FilesMatch "^(\.env|\.env\..+|composer\.json|composer\.lock|artisan|deploy\.sh|DEPLOY\.md|package\.json|package-lock\.json|vite\.config\.js|phpunit\.xml)$">
    Require all denied
</FilesMatch>

# Bloquea acceso directo a carpetas privadas (sin chocar con /app, ruta del SPA,
# que ya está manejada por el RewriteRule de arriba).
RedirectMatch 403 ^/(bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$)
